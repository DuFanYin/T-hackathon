@startuml
' T-hackathon — architecture (current)
' Regenerate SVG: plantuml doc/ARCHITECTURE.puml

skinparam shadowing false
skinparam componentStyle rectangle
skinparam defaultTextAlignment left
skinparam wrapWidth 240

skinparam ArrowColor #2B2B2B
skinparam ArrowThickness 1

skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #2B2B2B
}

skinparam database {
  BackgroundColor #FFF7E6
  BorderColor #2B2B2B
}

skinparam cloud {
  BackgroundColor #EEF5FF
  BorderColor #2B2B2B
}

skinparam frame {
  BackgroundColor #F7F7F7
  BorderColor #2B2B2B
}

title T-hackathon — End-to-end Architecture

actor Operator as op

cloud "Public Internet / Hosting" as hosting {
  rectangle "Static host (e.g. Vercel)\noptional" as vercel
}

frame "Browser" as browser {
  rectangle "React dashboard (Vite)" as ui
  rectangle "fetch client\npoll ~3s + GET /logs/tail" as ui_api
}

frame "Backend (one Python process)" as backend {
  rectangle "FastAPI app" as fastapi
  rectangle "EngineManager" as mgr

  frame "Trading engine (in-process)" as engine {
    rectangle "MainEngine\n(composition root)" as main
    rectangle "EventEngine\n(timer + worker)" as event

    rectangle "GatewayEngine\nRoostoo REST\n(mock|real keys)" as gateway
    rectangle "MarketEngine\nBinance klines" as market
    rectangle "StrategyEngine\nholdings + PnL" as strat
  }

  rectangle "OrderStore" as order_store
  rectangle "LogStore\n+ rotating file" as log_store
}

database "SQLite\n(data/orders/orders.db)" as sqlite
database "Rotating log\n(data/logs/system.log)" as log_file

cloud "External APIs" as external {
  rectangle "Roostoo REST\n(v3/*)\nsame host; keys by mode" as roostoo
  rectangle "Binance REST\n/api/v3/klines" as binance
}

op --> vercel : optional HTTPS
vercel --> ui : static assets

ui --> ui_api
ui_api --> fastapi : JSON\n/system/*, /strategies/*,\n/positions, /pairs,\n/account/*, /orders,\n/logs/tail

fastapi --> mgr : lifecycle
mgr --> main : MainEngine(env_mode)

main --> event : route + timer
event --> market : on_timer()
event --> gateway : on_timer()
event --> strat : process_timer();\n on_timer()

main --> log_store : write_log()
log_store --> log_file

gateway --> roostoo : signed REST
market --> binance : public klines

gateway --> order_store : order updates
order_store --> sqlite
fastapi --> sqlite : GET /orders

@enduml
